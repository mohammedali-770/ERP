# Copy to .env.local and fill in. `.env*` is gitignored; `.env.example` is not,
# and is the only one of the family that may ever hold a value — which is why it
# holds none.
#
# SEC-003: secrets live outside source code and are rotated through controlled
# procedures. Nothing here is a credential; these are the names of the ones the
# environment supplies.

# Which environment this shell is talking to. Nothing reads a hosted project
# until this is set deliberately.
ERP_ENV=local

# --- local, from `supabase start` -------------------------------------------
# `supabase start` prints these. They are local-only and rotate on every
# `supabase stop --no-backup`, so they are not secrets in any meaningful sense —
# but they still do not belong in git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# --- staging / production ---------------------------------------------------
# Deliberately left without defaults. A hosted project does not exist yet
# (ADR-0018 defers it to roughly 6-8 weeks before launch), and when it does,
# these come from the platform's secret store rather than from a file.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
