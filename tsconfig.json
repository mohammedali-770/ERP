{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "services/*/src/**/*.ts",
    "services/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "tools/*/src/**/*.ts",
    "tools/*/test/**/*.ts",
    "spikes/*/src/**/*.ts",
    "spikes/*/test/**/*.ts",
    "supabase/functions/_shared/**/*.ts"
  ]
}